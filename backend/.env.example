# Copy to .env and fill in. All values are optional for Phase 1 except DATABASE_URL,
# which defaults to a local SQLite file when unset.

# Local dev default (SQLite). For deploy, use the Supabase Postgres URL:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./adpilot.db

# Optional: pin the "meaningful spend" threshold used by the rule engine (Phase 2).
# Leave unset to compute it per-account as max(500, 5% of total account spend).
WASTE_COST_THRESHOLD=

# LLM explainer (Phase 4). Anthropic API key (sk-ant-...). When unset, the
# explainer falls back to deterministic templates and the audit still works.
# EXPLAINER_ENABLED=false disables the LLM call entirely (forces templates).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
EXPLAINER_ENABLED=true

# Twilio WhatsApp Sandbox. Needed for the Phase 0 smoke test
# (scripts/whatsapp_smoke_test.py) and Phases 5-6. See ../SETUP.md for how to get
# these. TWILIO_WHATSAPP_NUMBER is the sandbox sender, e.g. +14155238886
# (the "whatsapp:" prefix is added by the code).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
