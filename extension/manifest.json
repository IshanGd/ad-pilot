{
  "manifest_version": 3,
  "name": "AdPilot — instant Google Ads audit",
  "version": "0.1.0",
  "description": "Upload your Google Ads report and see exactly where your money is going. Free, no signup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
